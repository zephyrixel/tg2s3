# Telegram BotFather token and the numeric id of a private supergroup/channel.
TG2S3_BOT_TOKEN=
TG2S3_CHAT_ID=-1001234567890
TG2S3_TELEGRAM_BACKEND=bot_api

# Optional MTProto backend. Keep the Bot API as the default unless you need
# larger Telegram documents or streaming downloads without Bot API getFile.
# Values come from https://my.telegram.org, while the bot token above still
# comes from BotFather.
# TG2S3_TELEGRAM_API_ID=123456
# TG2S3_TELEGRAM_API_HASH=
# TG2S3_GRAMMERS_SESSION_PATH=./data/grammers.session.sqlite3
# Configure exactly one chat selector when TG2S3_TELEGRAM_BACKEND=grammers.
# TG2S3_GRAMMERS_CHAT_USERNAME=storage_channel
# TG2S3_GRAMMERS_CHAT_ACCESS_HASH=1234567890123456789
# TG2S3_GRAMMERS_MAX_FLOOD_WAIT_SECS=30

# Required only for the optional local Bot API Compose overlay. These values
# come from https://my.telegram.org, not from BotFather.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_API_REF=adfd7f6a8e990272851777eeb3ae0def4216f161
RUST_LOG=info

# S3 endpoint. Bind 0.0.0.0 inside Docker and keep anonymous mode disabled.
TG2S3_LISTEN=127.0.0.1:9000
TG2S3_ALLOW_ANONYMOUS=false
TG2S3_ACCESS_KEY=
TG2S3_SECRET_KEY=

# TG2S3_CHUNK_SIZE is the logical Telegram document block size. Upload and
# download streams use a fixed 1 MiB bounded buffer, so this value no longer
# allocates an equally large in-memory buffer. Requests without
# Content-Length are spooled below TG2S3_DATA_DIR/upload-spool before upload.
# Public Bot API mode uses 16 MiB chunks by default. In local Bot API mode,
# each getFile may materialize a complete document on the Bot API data volume;
# size that volume for the unique data read locally, not only this chunk size.
TG2S3_LOCAL_BOT_API=false
TG2S3_TELEGRAM_API_URL=https://api.telegram.org
TG2S3_CHUNK_SIZE=16777216
TG2S3_UPLOAD_CONCURRENCY=4
TG2S3_DOWNLOAD_CONCURRENCY=4
TG2S3_TELEGRAM_TIMEOUT_SECS=300

# Global transfer protection. Rate values are bytes per second; 0 disables a
# rate limit.
TG2S3_MAX_OBJECT_SIZE=53687091200
TG2S3_MAX_ACTIVE_TRANSFERS=16
TG2S3_LIMIT_WAIT_SECS=5
TG2S3_UPLOAD_RATE_BPS=0
TG2S3_DOWNLOAD_RATE_BPS=0

TG2S3_DATA_DIR=./data
TG2S3_REGION=us-east-1
TG2S3_INIT_BUCKETS=A

# Open CORS defaults for Cloudreve browser uploads. A Bucket-level
# PutBucketCors configuration can override these values in SQLite.
TG2S3_CORS_ALLOWED_ORIGINS=*
TG2S3_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,HEAD
TG2S3_CORS_ALLOWED_HEADERS=*
TG2S3_CORS_EXPOSE_HEADERS=ETag
TG2S3_CORS_MAX_AGE=3600

TG2S3_GC_INTERVAL=300
TG2S3_GC_LIMIT=100
