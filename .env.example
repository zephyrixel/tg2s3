# Telegram BotFather token and the numeric id of a private supergroup/channel.
TG2S3_BOT_TOKEN=
TG2S3_CHAT_ID=-1001234567890

# S3 endpoint. Bind 0.0.0.0 inside Docker and keep anonymous mode disabled.
TG2S3_LISTEN=127.0.0.1:9000
TG2S3_ALLOW_ANONYMOUS=false
TG2S3_ACCESS_KEY=
TG2S3_SECRET_KEY=

# Public Bot API mode uses 16 MiB chunks by default. Set this to true when
# TG2S3_TELEGRAM_API_URL points at a colocated local Bot API Server.
TG2S3_LOCAL_BOT_API=false
TG2S3_TELEGRAM_API_URL=https://api.telegram.org
TG2S3_CHUNK_SIZE=16777216
TG2S3_UPLOAD_CONCURRENCY=4
TG2S3_DOWNLOAD_CONCURRENCY=4

TG2S3_DATA_DIR=./data
TG2S3_REGION=us-east-1
TG2S3_INIT_BUCKETS=A

# Open CORS defaults for Cloudreve browser uploads. A Bucket-level
# PutBucketCors configuration can override these values in SQLite.
TG2S3_CORS_ALLOWED_ORIGINS=*
TG2S3_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,HEAD
TG2S3_CORS_ALLOWED_HEADERS=*
TG2S3_CORS_EXPOSE_HEADERS=ETag
TG2S3_CORS_MAX_AGE=3600

TG2S3_GC_INTERVAL=300
TG2S3_GC_LIMIT=100
